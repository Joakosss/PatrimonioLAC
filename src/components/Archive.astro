---
const text = await import('../data/texts/archive.md');
const { badge, title, description, ctaLabel, ctaHref, images } = text.frontmatter;
---

<section id="archivo" class="archive">
  <div class="archive-container">
    <div class="archive-header">
      <span class="archive-badge">{badge}</span>
      <h2 class="archive-title">{title}</h2>
      <p class="archive-description">{description}</p>
    </div>

    <div class="archive-grid">
      {images.map((img) => (
        <figure class="archive-item" data-lightbox>
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            width="600"
            height="400"
          />
          <figcaption class="archive-caption">
            <span class="archive-img-title">{img.title}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="archive-cta">
      <a href={ctaHref} class="btn btn-primary">{ctaLabel}</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#archivo [data-lightbox]').forEach((item) => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img');
      if (!img) return;

      const overlay = document.createElement('div');
      overlay.className = 'lightbox-overlay';
      overlay.innerHTML = `
        <div class="lightbox-content">
          <img src="${img.src}" alt="${img.alt}" />
          <button class="lightbox-close" aria-label="Cerrar">&times;</button>
        </div>
      `;

      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay || (e.target as Element).classList.contains('lightbox-close')) {
          overlay.remove();
          document.body.style.overflow = '';
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          overlay.remove();
          document.body.style.overflow = '';
        }
      });
    });
  });
</script>

<style>
  .archive {
    padding: 6rem 2rem;
    background: var(--color-bg);
    overflow: hidden;
  }

  .archive-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .archive-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .archive-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-yellow);
    background: rgba(255, 204, 0, 0.15);
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    margin-bottom: 1.25rem;
  }

  .archive-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .archive-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .archive-item {
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    background: white;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .archive-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .archive-item img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .archive-caption {
    padding: 1rem 1.25rem;
  }

  .archive-img-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .archive-cta {
    text-align: center;
    margin-top: 3rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--color-accent-red);
    color: white;
  }

  .btn-primary:hover {
    background: #c4151f;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
