---
const text = await import('../data/texts/about.md');
const { sectionTitle, sectionSubtitle, cards, contactCTA, contactLink, contactEmail } = text.frontmatter;
---

<section id="sobre" class="about">
  <div class="about-container">
    <h2 class="section-title">{sectionTitle}</h2>
    <p class="section-subtitle">
      {sectionSubtitle}
    </p>

    <div class="about-grid">
      {cards.map((card) => (
        <div class="about-card">
          <div class="card-icon">{card.icon}</div>
          <h3>{card.title}</h3>
          <p>{card.description}</p>
        </div>
      ))}
    </div>

    <div class="about-contact">
      <p>{contactCTA}</p>
      <a href={contactEmail} class="contact-link">
        {contactLink}
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 6rem 2rem;
    background: white;
  }

  .about-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
    font-size: 1.05rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .about-card {
    padding: 2rem;
    border-radius: 8px;
    background: var(--color-bg);
    text-align: center;
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .about-card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .about-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .about-contact {
    text-align: center;
    padding: 2rem;
    background: var(--color-bg);
    border-radius: 8px;
  }

  .about-contact p {
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .contact-link {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-accent-red);
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-link:hover {
    color: #c4151f;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
