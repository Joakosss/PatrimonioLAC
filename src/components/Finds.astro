---
import photos from '../data/photos.json';

const findsPhotos = photos.filter((p) => p.category === 'hallazgos');
---

<section id="hallazgos" class="finds">
  <div class="finds-container">
    <h2 class="section-title"><span class="finds-icon">🔍</span> Hallazgos</h2>
    <p class="section-subtitle">Fotos antiguas y documentos históricos que hemos rescatado a lo largo de nuestra investigación.</p>

    <div class="finds-grid">
      {findsPhotos.map((photo) => (
        <figure class="finds-item" data-lightbox-finds>
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            width="600"
            height="400"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-lightbox-finds]').forEach((item) => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img');
      if (!img) return;

      const overlay = document.createElement('div');
      overlay.className = 'lightbox-overlay';
      overlay.innerHTML = `
        <div class="lightbox-content">
          <img src="${img.src}" alt="${img.alt}" />
          <button class="lightbox-close" aria-label="Cerrar">&times;</button>
        </div>
      `;

      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay || (e.target as Element).classList.contains('lightbox-close')) {
          overlay.remove();
          document.body.style.overflow = '';
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          overlay.remove();
          document.body.style.overflow = '';
        }
      });
    });
  });
</script>

<style>
  .finds {
    padding: 6rem 2rem;
    background: #f5f0e8;
  }

  .finds-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .finds-icon {
    margin-right: 0.5rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: 4rem;
    font-size: 1.05rem;
  }

  .finds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .finds-item {
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-bg);
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid var(--color-border);
  }

  .finds-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .finds-item img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .finds-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .finds-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 2rem;
  }

  .lightbox-content {
    position: relative;
    max-width: 900px;
    width: 100%;
  }

  .lightbox-content img {
    width: 100%;
    border-radius: 8px;
  }

  .lightbox-close {
    position: absolute;
    top: -2.5rem;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 2rem;
    cursor: pointer;
  }
</style>
