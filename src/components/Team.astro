---
import photos from '../data/photos.json';

const teamPhotos = photos.filter((p) => p.category === 'equipo');
---

<section id="equipo" class="team">
  <div class="team-container">
    <h2 class="section-title">Nuestro Equipo</h2>
    <p class="section-subtitle">Los estudiantes que investigan, digitalizan y preservan la memoria de nuestro liceo.</p>

    <div class="team-grid">
      {teamPhotos.map((photo) => (
        <figure class="team-item" data-lightbox-team>
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            width="600"
            height="400"
          />
          <figcaption class="team-caption">
            {photo.year && <span class="team-year">{photo.year}</span>}
            <span class="team-title">{photo.title}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-lightbox-team]').forEach((item) => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img');
      if (!img) return;

      const overlay = document.createElement('div');
      overlay.className = 'lightbox-overlay';
      overlay.innerHTML = `
        <div class="lightbox-content">
          <img src="${img.src}" alt="${img.alt}" />
          <button class="lightbox-close" aria-label="Cerrar">&times;</button>
        </div>
      `;

      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay || (e.target as Element).classList.contains('lightbox-close')) {
          overlay.remove();
          document.body.style.overflow = '';
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          overlay.remove();
          document.body.style.overflow = '';
        }
      });
    });
  });
</script>

<style>
  .team {
    padding: 6rem 2rem;
    background: #faf7f2;
  }

  .team-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: 4rem;
    font-size: 1.05rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .team-item {
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-bg);
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .team-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .team-item img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .team-caption {
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .team-year {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent-red);
    background: rgba(229, 26, 37, 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .team-title {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 2rem;
  }

  .lightbox-content {
    position: relative;
    max-width: 900px;
    width: 100%;
  }

  .lightbox-content img {
    width: 100%;
    border-radius: 8px;
  }

  .lightbox-close {
    position: absolute;
    top: -2.5rem;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 2rem;
    cursor: pointer;
  }
</style>
