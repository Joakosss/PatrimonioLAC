---
import photos from '../data/photos.json';

const text = await import('../data/texts/gallery.md');
const { sectionTitle, sectionSubtitle, sections } = text.frontmatter;
---

<section id="galeria" class="gallery">
  <div class="gallery-container">
    <h2 class="section-title">{sectionTitle}</h2>
    <p class="section-subtitle">
      {sectionSubtitle}
    </p>

    {sections.map((section) => {
      const sectionPhotos = photos.filter((p) => p.category === section.category);
      if (sectionPhotos.length === 0) return null;
      return (
        <div class="gallery-section" id={section.id}>
          <div class="section-header">
            <span class="section-icon">{section.icon}</span>
            <div>
              <h3 class="section-heading">{section.title}</h3>
              <p class="section-description">{section.description}</p>
            </div>
          </div>
          <div class="gallery-grid">
            {sectionPhotos.map((photo) => (
              <figure class="gallery-item" data-lightbox>
                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading="lazy"
                  width="600"
                  height="400"
                />
                <figcaption class="gallery-caption">
                  {photo.year && <span class="gallery-year">{photo.year}</span>}
                  <span class="gallery-title">{photo.title}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  document.querySelectorAll('[data-lightbox]').forEach((item) => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img');
      if (!img) return;

      const overlay = document.createElement('div');
      overlay.className = 'lightbox-overlay';
      overlay.innerHTML = `
        <div class="lightbox-content">
          <img src="${img.src}" alt="${img.alt}" />
          <button class="lightbox-close" aria-label="Cerrar">&times;</button>
        </div>
      `;

      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay || (e.target as Element).classList.contains('lightbox-close')) {
          overlay.remove();
          document.body.style.overflow = '';
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          overlay.remove();
          document.body.style.overflow = '';
        }
      });
    });
  });
</script>

<style>
  .gallery {
    padding: 6rem 2rem;
    background: #faf7f2;
  }

  .gallery-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: 4rem;
    font-size: 1.05rem;
  }

  .gallery-section {
    margin-bottom: 4rem;
  }

  .gallery-section:last-child {
    margin-bottom: 0;
  }

  .section-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-icon {
    font-size: 1.75rem;
    line-height: 1;
    margin-top: 0.15rem;
  }

  .section-heading {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .section-description {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .gallery-item {
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-bg);
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .gallery-item img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .gallery-caption {
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .gallery-year {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent-red);
    background: rgba(229, 26, 37, 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .gallery-title {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 2rem;
  }

  .lightbox-content {
    position: relative;
    max-width: 900px;
    width: 100%;
  }

  .lightbox-content img {
    width: 100%;
    border-radius: 8px;
  }

  .lightbox-close {
    position: absolute;
    top: -2.5rem;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 2rem;
    cursor: pointer;
  }
</style>
